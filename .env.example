# PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/lms
DB_POOL_MIN=2
DB_POOL_MAX=20

# Application timezone for class times, reminders and session end tracking
LMS_TIMEZONE=Asia/Kolkata

# Flask
FLASK_SECRET_KEY=change-this-to-a-long-random-value

# Razorpay TEST MODE
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=

# Payment mode: demo (safe local testing), auto (Razorpay if keys exist, otherwise demo), or razorpay (real/test Razorpay)
PAYMENT_MODE=razorpay

# RazorpayX payouts (requires an activated RazorpayX account and configured source account)
RAZORPAYX_ACCOUNT_NUMBER=your_razorpayx_source_account_number

# ---- Live classes (Jitsi). They always open INSIDE the LMS page.
# Option A (recommended): Jitsi-as-a-Service (free tier) - https://jaas.8x8.vc -> API keys
#   JAAS_APP_ID looks like vpaas-magic-cookie-xxxxxxxx ; JAAS_KEY_ID looks like vpaas-magic-cookie-xxxx/abc123
#   Put the private key (.pk) file path below, or paste it with \n for line breaks in JAAS_PRIVATE_KEY.
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY_PATH=
JAAS_PRIVATE_KEY=
# Option B: your own self-hosted Jitsi server (leave JAAS_* empty)
JITSI_DOMAIN=meet.jit.si

